---
import type { CollectionEntry } from 'astro:content';
import { articlePath, categoryPath, sitePath } from '../lib/content';
import { categoryLabel } from '../config/site';

interface Props { article: CollectionEntry<'articles'>; compact?: boolean; }
const { article, compact = false } = Astro.props;
const { data } = article;
const imageSrc = sitePath(data.image);
---
<article class:list={['article-card', { compact }]}>
  <a class="card-image" href={articlePath(data.slug)} aria-label={`Leer ${data.title}`}>
    <img src={imageSrc} alt={data.imageAlt} loading="lazy" style={`object-fit:${data.imageFit};object-position:${data.imagePosition}`} />
  </a>
  <div class="card-copy">
    <p class="eyebrow"><a href={categoryPath(data.category)}>{categoryLabel(data.category)}</a>{data.season && ` / ${data.season}`}</p>
    <h3><a href={articlePath(data.slug)}>{data.title}</a></h3>
    <p class="card-excerpt">{data.excerpt}</p>
  </div>
</article>
