---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getPublishedArticles, articlePath, categoryPath, sitePath } from '../lib/content';
import { categoryConfig, categoryLabel, siteConfig } from '../config/site';

const articles = await getPublishedArticles();
const featured = articles.find((article) => article.data.featured) || articles.find((article) => article.data.evergreen) || articles[0];
const evergreen = articles.filter((article) => article.data.evergreen && article.id !== featured?.id).slice(0, 6);
const market = articles.filter((article) => article.data.archive === 'mercado-2026-27').slice(0, 4);
const featuredImage = featured && sitePath(featured.data.image);
---
<BaseLayout title={siteConfig.name} description={siteConfig.description}>
  <div class="wrapper home-intro">
    <p class="eyebrow">Publicación editorial / Barça</p>
    <h1>El juego también se piensa.</h1>
    <p>{siteConfig.tagline}</p>
  </div>

  {featured && <section class="wrapper feature" aria-labelledby="featured-title">
    <div class="feature-copy">
      <p class="eyebrow">Artículo destacado / {categoryLabel(featured.data.category)}</p>
      <h2 id="featured-title"><a href={articlePath(featured.data.slug)}>{featured.data.title}</a></h2>
      <p class="lede">{featured.data.excerpt}</p>
    </div>
    <a class="feature-image" href={articlePath(featured.data.slug)} aria-label={`Leer ${featured.data.title}`}>
      <img src={featuredImage} alt={featured.data.imageAlt} style={`object-fit:${featured.data.imageFit};object-position:${featured.data.imagePosition}`} />
    </a>
  </section>}

  <div id="secciones" class="wrapper sections">
    <SectionHeading label="Últimos" />
    <div class="article-grid-list">
      {articles.filter((article) => article.id !== featured?.id).slice(0, 6).map((article) => <ArticleCard article={article} />)}
    </div>

    {evergreen.length > 0 && <>
      <SectionHeading label="Ideas que permanecen" />
      <div class="article-grid-list">
        {evergreen.map((article) => <ArticleCard article={article} compact />)}
      </div>
    </>}

    <SectionHeading label="Secciones" />
    <div class="section-directory">
      {categoryConfig.map((category) => <a class="directory-row" href={categoryPath(category.source)}><span>{category.label}</span><span aria-hidden="true">↗</span></a>)}
    </div>

    <section class="archive-band" aria-labelledby="archive-title">
      <div>
        <p class="eyebrow">Archivo</p>
        <h2 id="archive-title">Mercado 2026/27</h2>
      </div>
      <div>
        {market.slice(0, 3).map((article) => <ArticleCard article={article} compact />)}
        <p style="margin-top:1.5rem"><a class="eyebrow" href={`${import.meta.env.BASE_URL}archivo/mercado-2026-27/`}>Entrar en el archivo ↗</a></p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .section-directory { border-bottom: 1px solid var(--rule); }
  .directory-row { display:flex; justify-content:space-between; align-items:baseline; padding:1.1rem 0; border-bottom:1px solid var(--rule); text-decoration:none; font-size:clamp(1.8rem, 4vw, 4rem); line-height:.9; letter-spacing:-.05em; }
  .directory-row:last-child { border-bottom:0; }
  .directory-row span:last-child { font-size:1.5rem; letter-spacing:0; }
</style>
