---
const error = Astro.url.searchParams.get('error');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ONE SHOT / Studio</title>
    <style>
      :root { color-scheme: light; font-family: Arial, sans-serif; background: #e9e8e2; color: #171717; }
      body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 1.25rem; box-sizing: border-box; }
      main { width: min(32rem, 100%); background: #f5f4ef; border: 1px solid #aaa99f; padding: clamp(1.5rem, 5vw, 3rem); box-sizing: border-box; }
      .eyebrow { letter-spacing: .2em; text-transform: uppercase; font-size: .72rem; }
      h1 { font-size: clamp(2.6rem, 12vw, 5.5rem); line-height: .85; letter-spacing: -.08em; margin: 1rem 0 1.5rem; }
      p { line-height: 1.5; }
      a, button { display: inline-block; background: #171717; color: #f5f4ef; border: 0; padding: .85rem 1rem; font: inherit; text-decoration: none; cursor: pointer; }
      #app[data-state="loading"] .login, #app[data-state="ready"] .login { display: none; }
      #app[data-state="loading"] .loading, #app[data-state="ready"] .loading { display: block; }
      #app[data-state="ready"] .ready { display: block; }
      #app[data-state="ready"] .login { display: none; }
      .loading, .ready { display: none; }
      .error { color: #8b1e1e; }
    </style>
  </head>
  <body>
    <main id="app" data-state="loading">
      <p class="eyebrow">ONE SHOT / Studio</p>
      <h1>Publicar.</h1>
      <div class="loading"><p>Comprobando la sesión…</p></div>
      <div class="login">
        <p>El Studio es privado. Inicia sesión con la cuenta de GitHub autorizada para publicar.</p>
        {error === 'not-authorized' && <p class="error">Esta cuenta no tiene permiso para entrar.</p>}
        <a href="/api/auth/login">Entrar con GitHub</a>
      </div>
      <div class="ready">
        <p>Sesión autorizada. El editor completo se conectará en el siguiente paso.</p>
        <button id="logout" type="button">Cerrar sesión</button>
      </div>
    </main>
    <script>
      const app = document.querySelector<HTMLElement>('#app');
      fetch('/api/auth/me').then((response) => { if (app) app.dataset.state = response.ok ? 'ready' : 'login'; });
      document.querySelector('#logout')?.addEventListener('click', async () => { await fetch('/api/auth/logout', { method: 'POST' }); window.location.href = '/studio/'; });
    </script>
  </body>
</html>
