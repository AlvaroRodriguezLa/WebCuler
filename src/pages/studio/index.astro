---
import '../../../studio/style.css';
const githubPagesBuild = import.meta.env.BASE_URL.startsWith('/WebCuler/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#20201f" />
    <meta name="robots" content="noindex,nofollow" />
    <title>ONE SHOT / Studio</title>
    <style>
      .studio-gate { min-height: 100vh; display: grid; place-items: center; padding: 1rem; background: #e7e5df; }
      .studio-gate-card { width: min(34rem, 100%); padding: clamp(1.5rem, 6vw, 3rem); background: #f4f2ec; border: 1px solid #898780; }
      .studio-gate-card h1 { margin: .6rem 0 1.2rem; font-size: clamp(3.5rem, 15vw, 6rem); line-height: .86; letter-spacing: -.08em; }
      .studio-gate-card p { max-width: 30rem; }
      .studio-gate-card button, .studio-gate-card a { display: inline-block; padding: .85rem 1rem; background: #20201f; color: #f4f2ec; border: 0; text-decoration: none; font: inherit; cursor: pointer; }
      .studio-error { color: #8c201d; }
      [hidden] { display: none !important; }
      .studio-top { position: sticky; z-index: 3; top: 0; height: 58px; display: flex; align-items: center; justify-content: space-between; padding: 0 1.25rem; background: #20201f; color: #e7e5df; font-size: .72rem; letter-spacing: .16em; text-transform: uppercase; }
      .studio-top a, .studio-top button { color: inherit; }
      .studio-top a { text-decoration: none; font-weight: 800; }
      .studio-top button { border: 1px solid #65645f; padding: .45rem .65rem; background: transparent; font: inherit; cursor: pointer; }
      .draft-bar { padding: .75rem 1.25rem; background: #d8d5ce; border-bottom: 1px solid #898780; }
      .draft-bar label { display: flex; align-items: center; gap: .75rem; margin: 0; letter-spacing: .08em; }
      .draft-bar select { max-width: 34rem; margin: 0; }
      .status a { color: inherit; }
      .status[data-kind="error"] { color: #8c201d; }
      .status[data-kind="success"] { color: #246246; }
      .actions button:disabled { opacity: .55; cursor: wait; }
      .preview-copy { max-width: 50rem; text-align: justify; text-justify: inter-word; }
      @media(max-width:600px) {
        .studio-top { padding: 0 .8rem; }
        .studio-shell { display: block; }
        .editor-panel { padding: 1.4rem 1rem 1.7rem; }
        .editor-panel h1 { font-size: clamp(3rem, 16vw, 4.7rem); }
        .editor-panel label { margin: 1.1rem 0; }
        .editor-panel textarea { min-height: 220px; font-size: 16px; }
        .advanced-grid { grid-template-columns: 1fr; }
        .advanced-grid .wide { grid-column: auto; }
        .actions { grid-template-columns: 1fr; position: sticky; bottom: 0; padding: .6rem 0; background: #e7e5df; }
        .preview-panel { padding: .8rem; }
        .preview-page { padding: 1.2rem; min-height: 0; }
        .preview-grid { grid-template-columns: 1fr; gap: 1.5rem; }
        .preview-title { font-size: clamp(3rem, 15vw, 4.5rem); }
        .preview-image { grid-row: 2; border-left: 0; border-top: 1px solid var(--rule); padding: 1rem 0 0; }
        .preview-image img { height: min(90vw, 380px); }
        .preview-wrap.mobile .preview-copy { grid-row: auto; }
        .draft-bar { padding: .7rem .8rem; }
        .draft-bar label { align-items: flex-start; flex-direction: column; gap: .35rem; }
      }
    </style>
  </head>
  <body>
    <main id="gate" class="studio-gate" data-state="loading" data-github-pages={githubPagesBuild ? 'true' : 'false'}>
      <section class="studio-gate-card">
        <p class="eyebrow">ONE SHOT / Studio privado</p>
        <h1>Publicar.</h1>
        <p id="gate-message">Comprobando tu sesión…</p>
        <p id="gate-error" class="studio-error" hidden></p>
        <a id="login-link" href="/api/auth/login" hidden>Entrar con GitHub</a>
        <button id="retry-login" type="button" hidden>Volver al login</button>
      </section>
    </main>
    <div id="studio-app" hidden></div>
    <script is:inline>
      const gate = document.querySelector('#gate');
      const gateMessage = document.querySelector('#gate-message');
      const gateError = document.querySelector('#gate-error');
      const app = document.querySelector('#studio-app');
      const login = document.querySelector('#login-link');
      const showError = new URLSearchParams(location.search).get('error') === 'not-authorized';
      async function startStudio() {
        try {
          const response = await fetch('/api/auth/me', { credentials: 'same-origin', cache: 'no-store' });
          if (!response.ok) {
            gateMessage.textContent = 'El Studio está reservado a la cuenta autorizada.';
            if (showError) { gateError.textContent = 'Esta cuenta de GitHub no tiene permiso para entrar.'; gateError.hidden = false; }
            login.hidden = false;
            return;
          }
          const editorResponse = await fetch('/api/studio/editor', { credentials: 'same-origin', cache: 'no-store' });
          const editor = await editorResponse.text();
          if (!editorResponse.ok) throw new Error(editor || 'No se pudo abrir el editor.');
          app.innerHTML = editor;
          gate.hidden = true;
          app.hidden = false;
          app.querySelector('#logout').addEventListener('click', async () => {
            await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
            location.href = '/studio/';
          });
          const script = document.createElement('script');
          script.src = '/studio-editor.js';
          script.onload = () => document.dispatchEvent(new CustomEvent('studio:authorized'));
          script.onerror = () => { app.hidden = true; gate.hidden = false; gateMessage.textContent = 'No se pudo cargar el editor. Recarga la página.'; document.querySelector('#retry-login').hidden = false; };
          document.body.append(script);
        } catch (error) {
          gateMessage.textContent = error.message || 'No se pudo comprobar la sesión. Revisa tu conexión.';
          document.querySelector('#retry-login').hidden = false;
        }
      }
      document.querySelector('#retry-login').addEventListener('click', () => location.reload());
      if (gate.dataset.githubPages === 'true') {
        gateMessage.textContent = 'El Studio privado está alojado en Vercel.';
        login.href = 'https://1shot-studio.vercel.app/studio/';
        login.textContent = 'Abrir Studio';
        login.hidden = false;
      } else {
        startStudio();
      }
    </script>
  </body>
</html>
